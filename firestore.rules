rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.email == "admin@conduzirtalentos.com"
      );
    }

    function ownsCompany(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function companyCanAccessCandidates() {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(request.auth.uid))
        && (get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.planActive == true
          || get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.paymentStatus == "Ativo")
        && ((get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.permissions is map
            && get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.permissions.curriculumAccess == true)
          || (get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.recurringPermissions is map
            && get(/databases/$(database)/documents/companies/$(request.auth.uid)).data.recurringPermissions.curriculumAccess == true));
    }

    function ownsCandidateData(data) {
      return signedIn() && (data.uid == request.auth.uid || data.candidateUid == request.auth.uid);
    }

    function ownsCompanyData(data) {
      return signedIn() && data.companyUid == request.auth.uid;
    }

    function isStaff() {
      return isAdmin() || (signedIn()
        && exists(/databases/$(database)/documents/system_users/$(request.auth.uid))
        && get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.deleted != true
        && get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.status != "Bloqueado");
    }

    function ownsService(data) {
      return signedIn() && (
        data.candidateUid == request.auth.uid
        || data.uid == request.auth.uid
        || data.companyUid == request.auth.uid
        || data.candidateEmail == request.auth.token.email
        || data.email == request.auth.token.email
        || data.contactEmail == request.auth.token.email
      );
    }

    function financialFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "planCode",
        "planName",
        "contractedPlanPrice",
        "contractedAt",
        "billingCycle",
        "asaasCustomerId",
        "asaasSubscriptionId",
        "asaasPaymentId",
        "paymentStatus",
        "planActive",
        "lastPaymentAt",
        "lastPaymentDueDate",
        "lastPaymentEvent",
        "lastPaymentStatus",
        "permissions",
        "recurringPermissions"
      ]);
    }

    function discFields() {
      return [
        "discCompleted",
        "discCompletedAt",
        "discResult"
      ];
    }

    function discFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(discFields());
    }

    function mayWriteCandidateDiscOnce(id) {
      return signedIn()
        && request.auth.uid == id
        && resource.data.discCompleted != true
        && request.resource.data.discCompleted == true
        && request.resource.data.discResult.candidateUid == request.auth.uid;
    }

    function isDiscFeedback(id) {
      return id == "disc_" + request.auth.uid;
    }

    function validOwnDiscFeedback(id) {
      return isDiscFeedback(id)
        && !exists(/databases/$(database)/documents/feedbacks/$(id))
        && request.resource.data.tipo == "Teste DISC"
        && request.resource.data.candidateUid == request.auth.uid
        && request.resource.data.locked == true;
    }

    match /companies/{uid} {
      allow read: if ownsCompany(uid) || isStaff();
      allow create: if ownsCompany(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAcknowledged == true
        && request.resource.data.recruitmentDataCommitment == true
        && request.resource.data.planActive == false
        && request.resource.data.paymentStatus == "Pendente"
        && request.resource.data.planName == ""
        && !request.resource.data.keys().hasAny([
          "contractedPlanPrice",
          "contractedAt",
          "asaasCustomerId",
          "asaasSubscriptionId",
          "asaasPaymentId"
        ]);
      allow update: if isStaff() || (ownsCompany(uid)
        && financialFieldsUnchanged()
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAcknowledged == true
        && request.resource.data.recruitmentDataCommitment == true);
      allow delete: if isAdmin();
    }

    match /catalog_items/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /billing_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_sessions/{id} {
      allow read: if isStaff() || ownsCompanyData(resource.data) || ownsCandidateData(resource.data);
      allow write: if isAdmin();
    }

    match /payment_history/{id} {
      allow read: if isStaff() || ownsCompanyData(resource.data) || ownsCandidateData(resource.data);
      allow write: if isAdmin();
    }

    match /asaas_webhook_events/{id} {
      allow read, write: if isAdmin();
    }

    match /candidates/{id} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == id);
      allow create: if isStaff() || (signedIn()
          && request.auth.uid == id
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.termsAccepted == true
          && request.resource.data.privacyAcknowledged == true
          && !request.resource.data.keys().hasAny([
            "asaasCustomerId", "asaasSubscriptionId", "asaasPaymentId", "paymentStatus", "lastPaymentAt"
          ])
        && request.resource.data.termsAccepted == true
        && request.resource.data.privacyAcknowledged == true
        && (!request.resource.data.keys().hasAny(discFields())
          || (request.resource.data.discCompleted == true && request.resource.data.discResult.candidateUid == request.auth.uid)));
      allow update: if isStaff()
        || (signedIn() && request.auth.uid == id
          && request.resource.data.uid == request.auth.uid
          && financialFieldsUnchanged()
          && request.resource.data.diff(resource.data).affectedKeys().hasNone([
            "validated", "seloConduzir", "decisionBy", "decisionAt",
            "lastServiceDeliveredAt", "lastServiceDeliveredBy", "lastServiceDeliveryMessage"
          ])
          && (discFieldsUnchanged() || mayWriteCandidateDiscOnce(id)));
      allow delete: if isAdmin();
    }

    match /candidate_public_profiles/{id} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == id)
        || (companyCanAccessCandidates() && resource.data.visible == true && resource.data.validated == true);
      allow create, update: if isStaff();
      allow delete: if isStaff() || (signedIn() && request.auth.uid == id);
    }

    match /jobs/{id} {
      allow read: if true;
      allow create: if isStaff() || ownsCompanyData(request.resource.data);
      allow update: if isStaff() || (ownsCompanyData(resource.data) && request.resource.data.companyUid == resource.data.companyUid);
      allow delete: if isStaff() || ownsCompanyData(resource.data);
    }

    match /feedbacks/{id} {
      allow read: if isStaff() || ownsCandidateData(resource.data);
      allow create: if isStaff() || validOwnDiscFeedback(id);
      allow update, delete: if isStaff();
    }

    match /system_users/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /service_requests/{id} {
      allow read: if isStaff() || ownsService(resource.data);
      allow create: if isStaff() || ownsService(request.resource.data);
      allow update: if isStaff() || (ownsService(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["messages", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /interviews/{id} {
      allow read: if isStaff() || ownsCandidateData(resource.data) || ownsCompanyData(resource.data);
      allow create, update, delete: if isStaff();
    }

    match /internal_notes/{id} {
      allow read, write: if isStaff();
    }

    match /privacy_requests/{id} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterEmail == request.auth.token.email
        && request.resource.data.requesterType in ["candidate", "company"]
        && request.resource.data.status == "Recebida"
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 3000
        && request.resource.data.requestType in ["access", "correction", "deletion", "revoke_consent", "automated_review", "information", "incident"];
      allow read: if isStaff() || (signedIn() && resource.data.requesterUid == request.auth.uid);
      allow update: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
