{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "functions/**",
      "**/.*",
      "**/node_modules/**",
      "conduzir.zip",
      "LGPD_OPERACAO.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-store, max-age=0" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/asaas/checkout",
        "function": {
          "functionId": "createAsaasCheckout",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/api/asaas/webhook",
        "function": {
          "functionId": "asaasWebhook",
          "region": "southamerica-east1"
        }
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/consultora",
        "destination": "/consultora.html"
      },
      {
        "source": "/empresa",
        "destination": "/empresa.html"
      },
      {
        "source": "/candidato",
        "destination": "/candidato.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
